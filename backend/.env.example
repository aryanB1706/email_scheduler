# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (Prisma) — host port 5435 is mapped via docker-compose to avoid clash with system postgres on 5432
# If you free host 5432, change to 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/email_scheduler?schema=public"

# Redis (BullMQ) — host port 6380 via docker-compose (system redis occupies 6379)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Ethereal Email (https://ethereal.email) — create account at https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
SMTP_FROM="Email Scheduler <no-reply@example.com>"

# Google OAuth (for User model)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Worker
CONCURRENCY=5
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Auth / Session
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:5173
# Dev bypass (local only, never enable in production) — adds POST /api/auth/dev-login
ALLOW_DEV_LOGIN=false
